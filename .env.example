# scripts/demo.ps1 / demo.sh generate this file with random values. Passwords: only [A-Za-z0-9_-], 12+ chars.
HIAB_ADMIN_TOKEN=change-me-admin-token
HIAB_DB_PASSWORD=change-me-db-password
HIAB_REDIS_PASSWORD=change-me-redis-password
HIAB_ANALYST_DB_PASSWORD=change-me-analyst-pw
HIAB_INGEST_DB_PASSWORD=change-me-ingest-pw
HIAB_CONTROL_DB_PASSWORD=change-me-control-pw
# Optional: LLM prose in the analyst service only (decoy and control never see this key)
ANTHROPIC_API_KEY=
# Optional: folder containing GeoLite2-City.mmdb (MaxMind licence; not bundled)
HIAB_GEOIP_DIR=./geoip
